# VLX FrameFlow Server Profile
FRAMEFLOW_USER="frameflow"
VLXsuite_DIR="/opt/VLX_FrameFlow"
MEDIAMTX_DIR="/opt/mediamtx"

# Network settings
FRAMEFLOW_ROLE="SERVER"
MPTCP_PROXY_PASS=""
MLVPN_KEY=""

# Server API Relay Configuration
# This API acts as an internal transparent reverse proxy to relay local webhook
# commands directly to the backpack Client over the secure MLVPN tunnel.
# IMPORTANT: The Server API should STRICTLY bind to 127.0.0.1 for security.
# It is designed to be accessed locally by companion applications (e.g. ChatBridge).
bind_address="127.0.0.1"
bind_port="9090"
