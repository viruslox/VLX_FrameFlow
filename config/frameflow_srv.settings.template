# VLX FrameFlow Server Profile
# The dedicated, unprivileged user that runs background services inside privilege-dropped systemd units.
FRAMEFLOW_USER="frameflow"

# Installation Paths
# Paths dynamically resolved via os.Getenv("VLXsuite_DIR") in code, defaulting to:
VLXsuite_DIR="/opt/VLX_FrameFlow"
# Note: Architecture suffixes (e.g. AMD64 vs ARM64) for MediaMTX are handled automatically
# by the daemon's runtime.GOARCH resolution and do not need to be appended here.
MEDIAMTX_DIR="/opt/mediamtx"

# Network settings
# Explicitly sets the system to require root execution for main orchestrator daemons,
# while utilizing /etc/systemd/system/ and multi-user.target for unit files.
FRAMEFLOW_ROLE="SERVER"
# Password for the MPTCP proxy.
MPTCP_PROXY_PASS=""
# Key for the single-client MLVPN tunnel.
# MLVPN_KEY is used only for the legacy single-client tunnel (no peers.yaml).
# For multiple clients, define each one in etc/peers.yaml (see peers.yaml.template);
# when that file is present it takes precedence and each peer carries its own key.
MLVPN_KEY=""

# Server API Relay Configuration
# This API acts as an internal transparent reverse proxy to relay local webhook
# commands directly to the backpack Client over the secure MLVPN tunnel.
# IMPORTANT: The Server API should STRICTLY bind to 127.0.0.1 for security.
# It is designed to be accessed locally by companion applications (e.g. ChatBridge).
bind_address="127.0.0.1"
bind_port="9090"

# Server Relay -> Client API target
# Address of the remote Client API on the far side of the MLVPN tunnel, used by
# the transparent reverse proxy relay. Leave at defaults unless the Client's
# MLVPN IP or API port differs from the standard 10.1.10.2:9090.
relay_client_host="10.1.10.2"
relay_client_port="9090"
