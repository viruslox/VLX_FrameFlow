###############################################
# VLX FrameFlow SERVER - MediaMTX Configuration
###############################################
logLevel: info
logDestinations: [syslog]
sysLogPrefix: mediamtx
readTimeout: 10s
writeTimeout: 10s

# 1. Security & Network
authMethod: internal
authInternalUsers:
  - user: any
    ips:
      - '127.0.0.1'
      - '::1'
      - '10.1.10.0/24' # Allow ingestion from MLVPN clients
    permissions:
      - action: publish
        path: offline
      - action: publish
        path: ~^wcam_.*
      - action: read
        path: any
# 2. Protocols Enablement
api: yes            # Required for the FrameFlow Frontend dashboard to list streams
metrics: no
pprof: no
playback: no
hls: no             # Too much latency, disabled
webrtc: yes         # CRITICAL: Enables sub-second Director's Monitoring in browser
srt: yes            # Primary ingest from backpack and output to VisionBridge
srtAddress: :8890
rtmp: yes           # Legacy fallback
rtmpAddress: :1935
rtsp: yes           # Standard local IPC
rtspAddress: :8554

# 3. Stream Routing & Seamless Fallback
paths:
  # The fallback loop that runs continuously in the background (0% CPU using stream_loop)
  # Ensure 'offline.mp4' has the EXACT same codec, resolution, and fps as the backpack stream.
  offline:
    runOnInit: ffmpeg -re -stream_loop -1 -i /opt/VLX_FrameFlow/assets/offline.mp4 -c copy -f rtsp rtsp://localhost:8554/offline
    runOnInitRestart: yes

#  ~^cam_.*:
#    fallback: /offline
  cam_01:
    fallback: /offline

  # Secondary ingestion path for the cameraman (smartphone or second backpack)
  cameraman:
    # Optional: You could add a fallback here as well
    # fallback: /offline_cameraman
